OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Authentication -------------------------------------------------------
# OFF by default so local development is unobstructed. The app shows a
# permanent banner while it is off, and escalates to an error if it is also
# bound to a non-loopback address.
# TURN THIS ON before anyone else can reach the app.
# PAS_AUTH_ENABLED=true
# PAS_ALLOW_SIGNUP=true        # let strangers create their own accounts
# PAS_DEFAULT_ROLE=viewer      # role for accounts after the first (which is owner)

# --- Models ---------------------------------------------------------------
# PAS_FAST_MODEL=openai/gpt-4.1-mini
# PAS_DEEP_MODEL=openai/gpt-4.1

# --- Limits ---------------------------------------------------------------
# PAS_DATA_DIR=./data
# PAS_MAX_LLM_CALLS=60
# PAS_HTTP_TIMEOUT=12
# PAS_MAX_PAGES_PER_DOMAIN=6

# --- Monitoring scheduler ---------------------------------------------------
# Runs due monitors automatically while the app is open. Off by default: it
# spends money on a timer. For unattended runs, point cron at run_due_monitors().
# PAS_SCHEDULER=true
# PAS_SCHEDULER_TICK=300

# --- Semantic retrieval -----------------------------------------------------
# Embeddings are cached per claim, so cost is paid once rather than per question.
# PAS_EMBEDDINGS=false
# PAS_EMBEDDING_MODEL=openai/text-embedding-3-small
